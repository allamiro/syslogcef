#!/sbin/openrc-run
description="syslog to CEF converter"

command="/usr/bin/syslogcef"
# OUTPUT_FILE is kept quoted through OpenRC's eval so strftime paths
# are not word-split; an empty value means stdout.
command_args="${INPUT_FILE} --tail --append --output \"${OUTPUT_FILE}\" ${EXTRA_ARGS}"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"

depend() {
	need localmount
	after net
}

start_pre() {
	# strftime-templated paths (containing %) create their own directories.
	case "${OUTPUT_FILE}" in
	*%*|"") ;;
	*) checkpath -d -m 0755 "$(dirname "${OUTPUT_FILE}")" ;;
	esac
}
