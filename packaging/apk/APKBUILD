# Maintainer: Tamir Suliman <allamiro@gmail.com>
pkgname=syslogcef
pkgver=0.3.2
pkgrel=0
pkgdesc="Convert syslog events to ArcSight CEF"
url="https://github.com/allamiro/syslogcef"
arch="noarch"
license="MIT"
depends="python3"
options="!check"
source="syslogcef-$pkgver.pyz syslogcef.initd syslogcef.confd syslogcef.1"

package() {
	install -Dm755 "$srcdir"/syslogcef-$pkgver.pyz "$pkgdir"/usr/bin/syslogcef
	install -Dm755 "$srcdir"/syslogcef.initd "$pkgdir"/etc/init.d/syslogcef
	install -Dm644 "$srcdir"/syslogcef.confd "$pkgdir"/etc/conf.d/syslogcef
	install -Dm644 "$srcdir"/syslogcef.1 "$pkgdir"/usr/share/man/man1/syslogcef.1
	gzip -9n "$pkgdir"/usr/share/man/man1/syslogcef.1
}
